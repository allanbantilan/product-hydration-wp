      {
        "id": "db2bf6db",
        "elType": "widget",
        "widgetType": "html",
        "settings": {
          "html": "<section class=\"section features\" id=\"features\"><div class=\"container\"><div class=\"section-head reveal\"><span class=\"eyebrow\">Thoughtful by design</span><h2>Everything you need.<br>Nothing in your way.</h2><p>Good habits should fit your life. Scroll to see how every detail works toward a simpler daily rhythm.</p></div><div class=\"feature-layout\"><div class=\"feature-visual\" data-feature=\"1\"><img class=\"product-svg\" src=\"/wp-content/themes/hydration-launch/assets/bottle.svg\" width=\"390\" height=\"690\" alt=\"Smart bottle with reminder ring\" loading=\"lazy\"><div class=\"feature-visual-label\"><span id=\"feature-label\">01 / Gentle reminders</span><span>HYDRATION / DAILY</span></div></div><div class=\"feature-steps\"><article class=\"feature-step is-active\" data-feature=\"1\" data-label=\"01 / Gentle reminders\"><span class=\"num\">01 / NOTICE</span><h3>Listen to the light.</h3><p>A soft illuminated ring gives you a quiet reminder to take a sip. No buzzing, no noisy notifications.</p></article><article class=\"feature-step\" data-feature=\"2\" data-label=\"02 / Lasting temperature\"><span class=\"num\">02 / ENJOY</span><h3>Your perfect temperature, for longer.</h3><p>Double wall insulation keeps your drink refreshingly cold or comfortingly warm through the whole day.</p></article><article class=\"feature-step\" data-feature=\"3\" data-label=\"03 / Everyday ease\"><span class=\"num\">03 / REPEAT</span><h3>Built for the long run.</h3><p>A durable, easy to clean form that makes reaching for water the easiest choice in the room.</p></article></div></div></div></section>"
        },
        "elements": []
      }
    ]
